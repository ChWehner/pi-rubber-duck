{
	"name": "pi-rubber-duck",
	"version": "1.0.0",
	"description": "A rubber duck for your coding agent. The model explains its problem out loud; the duck never answers.",
	"author": "Christoph Wehner",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"format": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "node --test index.test.ts",
		"test:markers": "node scripts/check-test-markers.mjs",
		"test:package": "node scripts/check-package-contents.mjs",
		"check": "npm run format && npm run typecheck && npm run test:markers && npm run test:package && npm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChWehner/pi-rubber-duck.git"
	},
	"homepage": "https://github.com/ChWehner/pi-rubber-duck#readme",
	"bugs": "https://github.com/ChWehner/pi-rubber-duck/issues",
	"keywords": [
		"pi",
		"pi-extension",
		"rubber-duck",
		"debugging",
		"coding-agent",
		"pi-package"
	],
	"files": [
		"index.ts",
		"duck.png"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.84.1",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"@earendil-works/pi-tui": "^0.84.1",
		"typebox": "^1.3.7"
	},
	"devDependencies": {
		"@types/node": "^22.18.0",
		"prettier": "^3.0.0",
		"typescript": "5.8.3"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"image": "https://raw.githubusercontent.com/ChWehner/pi-rubber-duck/develop/duck.png"
	},
	"knip": {
		"entry": [
			"index.ts",
			"index.test.ts"
		],
		"project": [
			"*.ts"
		]
	}
}
